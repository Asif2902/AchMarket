# ── Deployer wallet (contracts only — not required for app runtime) ──
DEPLOYER_PRIVATE_KEY=

# ── Network (backend + feeds) ───────────────────────────────────
RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002

# ── Backend server (VPS) ────────────────────────────────────────
# Public host: https://prediction.achswap.app  (nginx → 127.0.0.1:8080)
# AchSwap uses 3000; AchMarket uses 8080 on the same machine.
# Must be a real port number (not blank). Blank PORT makes Node bind a random port.
PORT=8080
NODE_ENV=production
BODY_LIMIT=15mb
# Optional override; default resolves to frontend/dist next to backend
# FRONTEND_DIST_DIR=

# ── MongoDB (profiles, chat, live feeds) ────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<db>
MONGO_DB_NAME=achmarket

# ── Cloudflare R2 (avatars + market media uploads) ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN base URL, e.g. https://cdn.achswap.app
R2_PUBLIC_BASE_URL=

# ── CORS (comma-separated full origins) ─────────────────────────
# ./up.sh fills this for prediction.achswap.app if left empty.
CORS_ALLOWED_ORIGINS=https://prediction.achswap.app

# ── WalletConnect (served to browser via /config.js) ────────────
VITE_WALLETCONNECT_PROJECT_ID=
# WALLETCONNECT_PROJECT_ID=

# ── Optional: TheSportsDB V1 key ────────────────────────────────
# Free public key 123 is used when unset.
THE_SPORTS_DB_API_KEY=

# ── Frontend build ──────────────────────────────────────────────
# Leave empty when nginx serves UI+API on the same host (recommended VPS setup).
VITE_API_BASE_URL=

# ── Factory contract (live config / feeds) ──────────────────────
FACTORY_ADDRESS=
